# ============================================================================
# B.Tech Student AI Learning Platform — Production Environment Configuration
# NEVER commit real production secrets, passwords, or private keys to source control.
# ============================================================================

# Runtime Environment
PORT=3000
NODE_ENV=production
APP_URL=https://platform.btech.edu

# Relational Database (PostgreSQL 16+)
DATABASE_URL=postgresql://postgres_user:secure_password_here@postgres:5432/btech_platform_db

# In-Memory Cache, Queue & Rate Limiter (Redis 7+)
REDIS_URL=redis://default:secure_redis_password_here@redis:6379/0

# Authentication & Session Security (Min 32 characters high entropy keys)
JWT_SECRET=replace_with_64_character_hex_or_random_secret_for_jwt_signing
JWT_REFRESH_SECRET=replace_with_64_character_hex_or_random_secret_for_refresh_token
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowlist (Comma-separated exact origins, no wildcard in production)
CORS_ORIGINS=https://platform.btech.edu,https://admin.btech.edu

# AI Provider Configurations (Encrypted at rest)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_or_compatible_fallback_api_key_here

# GitHub Integration (AES-256 GCM Token Encryption)
GITHUB_CLIENT_ID=your_production_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_production_github_oauth_client_secret
GITHUB_REDIRECT_URI=https://platform.btech.edu/api/v1/github/callback
GITHUB_TOKEN_ENCRYPTION_KEY=replace_with_32_byte_hex_key_for_aes_256_gcm_token_vault

# Academic Research Providers
OPENALEX_API_KEY=your_openalex_api_key_or_email_for_polite_pool
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_if_configured
CROSSREF_PLUS_API_KEY=your_crossref_api_key_if_configured

# Storage & Document Vault (LOCAL | S3 | GCS | MINIO)
STORAGE_DRIVER=LOCAL
STORAGE_LOCAL_PATH=./data/vault
MAX_UPLOAD_SIZE_BYTES=26214400

# Academic Certification Authority Signing Salts
CERTIFICATE_ISSUER_AUTHORITY="B.Tech AI Learning Platform Academic Verification Board"
CERTIFICATE_SIGNING_SALT=replace_with_cryptographic_salt_for_certificate_hashes
PUBLIC_VERIFICATION_HOST=https://platform.btech.edu

# ============================================================================
# Phase 5: Firebase Authentication, Supabase profile store, AI limits
# See docs/phase-5/PHASE_5_ENVIRONMENT_CONFIGURATION.md for every variable.
# ============================================================================

# --- Authentication provider (backend) ---
# legacy   = existing email/password + JWT (default while Firebase is not configured)
# firebase = Firebase Authentication is the only sign-in; legacy tokens and password endpoints are refused
# Setting FIREBASE_PROJECT_ID alone also selects firebase.
AUTH_PROVIDER=legacy
FIREBASE_PROJECT_ID=otp-project-846a9
# Optional: path to a service-account JSON for other Admin SDK features. Not needed to verify
# ID tokens. Keep the file outside the repository; never commit it.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-admin.json
# Treat unverified email addresses as incomplete accounts (always on in firebase mode).
REQUIRE_EMAIL_VERIFICATION=false

# --- Firebase web config (frontend, compiled into the bundle; public identifiers, not secrets) ---
# The web API key was not provided: copy it from Firebase console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=replace_with_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=otp-project-846a9.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=otp-project-846a9
VITE_FIREBASE_STORAGE_BUCKET=otp-project-846a9.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=487403899918
VITE_FIREBASE_APP_ID=1:487403899918:web:dec541a4e5ea73eb43805f
VITE_FIREBASE_MEASUREMENT_ID=G-XV1PRQ2Z7H

# --- Student profile store (backend only) ---
# snapshot = JSON snapshot store (default). supabase = Supabase Postgres is authoritative.
# Setting SUPABASE_DB_URL alone also selects supabase.
PROFILE_STORE=snapshot
SUPABASE_URL=https://your-project-ref.supabase.co
# Direct Postgres connection string (Supabase > Project settings > Database). SERVER ONLY.
SUPABASE_DB_URL=
# Not used by the app today; if you add it, it is SERVER ONLY. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# The anon key is safe for browsers but the app does not need it (the browser talks only to this backend).
SUPABASE_ANON_KEY=

# --- Gemini (backend only; never VITE_GEMINI_*) ---
# Use a NEW key. The key that was exposed earlier must stay revoked.
GEMINI_TIMEOUT_MS=30000
AI_MAX_PROMPT_CHARS=200000

# ============================================================================
# Vercel (serverless) deployment. See docs/deployment/VERCEL_DEPLOYMENT.md.
# ============================================================================
# postgres = all app data in Postgres (default on Vercel); file = JSON snapshot on disk (default elsewhere)
STATE_STORE=
# Optional separate database for app state; defaults to SUPABASE_DB_URL.
# On Vercel use the Supabase TRANSACTION POOLER string (port 6543), not db.<ref>.supabase.co:5432.
STATE_DB_URL=
# Apply supabase/migrations/*.sql automatically on cold start (default true).
RUN_DB_MIGRATIONS=true
# Base64 of the Firebase Admin service-account JSON (server only). Alternative to GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Vercel caps request bodies at 4.5 MB and uploads are base64, so keep this at or under 3000000 there.
# MAX_UPLOAD_SIZE_BYTES=3000000
# Never true on Vercel: there is no isolated sandbox, so student code could read server secrets.
CODE_SANDBOX_ALLOW_UNISOLATED=false
