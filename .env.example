# ============================================================================
# B.Tech Student AI Learning Platform — Production Environment Configuration
# NEVER commit real production secrets, passwords, or private keys to source control.
# ============================================================================

# Runtime Environment
PORT=3000
NODE_ENV=production
APP_URL=https://platform.btech.edu

# Relational Database (PostgreSQL 16+)
DATABASE_URL=postgresql://postgres_user:secure_password_here@postgres:5432/btech_platform_db

# In-Memory Cache, Queue & Rate Limiter (Redis 7+)
REDIS_URL=redis://default:secure_redis_password_here@redis:6379/0

# Authentication & Session Security (Min 32 characters high entropy keys)
JWT_SECRET=replace_with_64_character_hex_or_random_secret_for_jwt_signing
JWT_REFRESH_SECRET=replace_with_64_character_hex_or_random_secret_for_refresh_token
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowlist (Comma-separated exact origins, no wildcard in production)
CORS_ORIGINS=https://platform.btech.edu,https://admin.btech.edu

# AI Provider Configurations (Encrypted at rest)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_or_compatible_fallback_api_key_here

# GitHub Integration (AES-256 GCM Token Encryption)
GITHUB_CLIENT_ID=your_production_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_production_github_oauth_client_secret
GITHUB_REDIRECT_URI=https://platform.btech.edu/api/v1/github/callback
GITHUB_TOKEN_ENCRYPTION_KEY=replace_with_32_byte_hex_key_for_aes_256_gcm_token_vault

# Academic Research Providers
OPENALEX_API_KEY=your_openalex_api_key_or_email_for_polite_pool
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_if_configured
CROSSREF_PLUS_API_KEY=your_crossref_api_key_if_configured

# Storage & Document Vault (LOCAL | S3 | GCS | MINIO)
STORAGE_DRIVER=LOCAL
STORAGE_LOCAL_PATH=./data/vault
MAX_UPLOAD_SIZE_BYTES=26214400

# Academic Certification Authority Signing Salts
CERTIFICATE_ISSUER_AUTHORITY="B.Tech AI Learning Platform Academic Verification Board"
CERTIFICATE_SIGNING_SALT=replace_with_cryptographic_salt_for_certificate_hashes
PUBLIC_VERIFICATION_HOST=https://platform.btech.edu
